hs_err_pid*
replay_pid*

# Maven build output
target/

# macOS
.DS_Store

# 仓内发布凭据（Sonatype User Token + GPG passphrase），由 004_重要秘钥 口径落到这里
.env
.env.bak

# 运行态与编译产物（由 2026-10-08 lead 同步并入；与上方上游块取并集，不覆盖上游新增的凭据排除）

# 前端 node_modules / dist
_frontend/**/node_modules/
_frontend/**/dist/

# 桌面壳（Tauri）：依赖、前端产物、Rust target、打包时拷入的 jar/内嵌 JRE 都不入库
/z-bot-desk/node_modules/
/z-bot-desk/dist/
/z-bot-desk/src-tauri/target/
/z-bot-desk/src-tauri/gen/
/z-bot-desk/src-tauri/resources/
# build-dmg.sh 会把 z-bot-desk 的 dist 拷进 jar classpath（文件名带哈希），不入库
/z-bot-core/src/main/resources/web/workspace/
# ===== lead 002 规范：临时/运行态件一律写 <仓>/.cache/，且 .cache 必须被 ignore =====
/.cache/

# ===== lead 002 规范 R7：运行态/临时件不进 git =====
__pycache__/	# python 字节码缓存（lead 002 规范 R7）
*.pyc	# python 字节码（lead 002 规范 R7）

# ============ vite 构建旧产物（沙箱删除闸 ⇒ 只移不删，遗留带时间戳的兄弟目录） ============
dist.stale-*/
**/dist.stale-*/
dist.bak-*/
**/dist.bak-*/

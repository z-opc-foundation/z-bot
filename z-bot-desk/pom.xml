    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-bot</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-bot-desk</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-bot-desk</name>
    <description>桌面壳：React + Vite 前端 + Tauri 2，前端产物由 build-dmg.sh 拷进 z-bot-core 的 classpath，经 /workspace 下发</description>

    <!--
        本模块为纯前端 + Rust 工程（npm / cargo），不在 Maven reactor 里；
        Maven 构建只用来给 IDE 一个工程壳。真正的构建入口是：
          scripts/build-dmg.sh（npm build → 拷 dist 进 z-bot-core classpath → 打 fat JAR → jlink → tauri build）

        开发模式：
          1. 启动后端：java -jar z-bot-core/target/z-bot-core.jar serve --port 28080
          2. 启动前端 dev server：cd z-bot-desk && npm run dev
          3. 浏览器访问 http://localhost:5173/workspace（API 代理到 28080）

        生产模式：
          z-bot-core 的 classpath 里带 web/workspace（Vite 产物），jar 直接同源托管：
          http://127.0.0.1:28080/workspace
    -->

</project>

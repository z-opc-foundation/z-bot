<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-bot: 本地 agent 应用 (对标 Claude Code / Hermes).
        - core: LLM 调用 + Agent runtime + CLI + HTTP server + 本地 sandbox
        - desktop-packager: jpackage 配置 (生成 .dmg / .exe / .deb)

        设计原则:
        - 不引入 Spring, 走 z-boot 的轻量模式 (直接用 kernel.* SPI + 自带 CLI)
        - HTTP server 走 JDK 内置 com.sun.net.httpserver.HttpServer
        - 数据持久化走本地 SQLite (jdbc)
    -->

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径，试点 z-cache）：它继承第三方地板
         z-boot-dependencies:1.0.19、import 兄弟仓权威 z-boot-fleet:1.0.0，并下发 Java 8 的
         pluginManagement。以前这里没有 <parent>，版本属性表全自建。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.0.21</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-bot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-bot (Local Agent App, cc/Hermes style)</name>
    <description>本地 agent 应用: CLI + HTTP 双通道 + sandbox + 内置 z-agent-kernel runtime</description>
    <url>https://github.com/z-opc-foundation/z-bot</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-bot.git</connection>
        <developerConnection>scm:ssh:git@github.com/z-opc-foundation/z-bot.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-bot</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-bot-core</module>
        <module>z-bot-desktop-packager</module>
    </modules>

    <properties>
        <revision>0.2.1</revision>

        <!--
            删掉、改由父链下发的键：maven.compiler.source=8 / maven.compiler.target=8 /
            project.build.sourceEncoding=UTF-8（父链面值逐字相同，z-boot-parent/pom.xml:56-58）、
            okhttp.version=4.12.0（地板 okhttp 直接条目同值 4.12.0）。

            留着的三格都是**不能删**：
            - jackson.version=2.13.5 对地板 2.18.6：刻意的零漂移，靠下面按坐标写的三条直接条目顶住。
            - z-agent-kernel.version=0.2.1：**这格删不得**——下面 12 条 kernel 直接 DM 条目引用的就是这个
              属性，属性一没，那 12 条就解不开。它存在的理由**不是**"顶住 fleet 的旧面值"：
              `z-boot-parent:1.0.21` 导入的是 `z-boot-fleet:1.0.1`，该 fleet 自己就供
              `z-agent-kernel.version=0.2.1`（同值；fleet 1.0.0 那版才是 0.1.1）。
              同一次现读（2026-10-01 19:1x）：`z-boot-parent:1.0.21` 的 `<z-boot-fleet.version>` 是
              **1.0.1**，该 fleet 里 `z-agent-kernel.version=0.2.1`、`z-bot.version=0.2.0`、
              `z-script.version=1.0.1`（fleet 1.0.0 那版才是 0.1.1 / 0.1.0 / 1.0.0）——此前这里写的
              "对 fleet 的 0.1.1"是 fleet 1.0.0 时代的旧读数，已作废。
              可拉性复核（同一次现读 repo1）：13 件 `z-agent-kernel*` 的 `0.2.1` pom **全部 200**
              （`-llm`/`-credential` 的 jar 也 200），`0.2.0` **全部 404**（那条从未发布，本机
              ~/.m2 里有 ≠ repo1 有），`0.1.1` 全部 200；`z-agent-kernel/maven-metadata.xml` 的
              latest/release 都是 `0.2.1`（`lastUpdated=20260929000844`）。复算：
              `curl -s https://repo1.maven.org/maven2/io/github/yuku123/z-boot-fleet/1.0.1/z-boot-fleet-1.0.1.pom | grep -n 'version>'`
              `curl -s -o /dev/null -w %{http_code} https://repo1.maven.org/maven2/io/github/yuku123/<a>/<v>/<a>-<v>.pom`
            - jline.version=3.24.1：父链不供这个坐标。
        -->
        <z-agent-kernel.version>0.2.1</z-agent-kernel.version>
        <jline.version>3.24.1</jline.version>
        <jackson.version>2.13.5</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 自家 3 个 reactor 坐标钉 ${project.version}。继承来的 DM 会改写**传递依赖**的版本，
                 而 fleet 里 z-bot 那格钉的是 repo1 已发布的那一版（2026-10-01 现读 `z-boot-fleet:1.0.1`
                 是 `z-bot.version=0.2.0`；本仓 revision 已抬到 0.2.1 ⇒ 永远滞后一格）⇒ 任何
                 指向自家模块的依赖边都会被反向压成旧字节码（z-cache 试点实测踩过：shade 把
                 1.3.5 打进 1.3.6 的包里）。本仓今天还没有 sibling 依赖边（packager 只读 core 的
                 target 目录），这三条是把面值先钉死。z-bot / z-bot-desktop-packager 是 packaging=pom，
                 条目必须带 <type>pom</type>（受管项按 g:a:type:classifier 匹配）。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-bot</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-bot-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-bot-desktop-packager</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>

            <!--
                spring-boot-dependencies:2.7.18 的 import 删掉：地板 import 的就是同一格 2.7.18
                （z-boot-dependencies/pom.xml:225-229，${spring-boot.version}），重复 import 只是
                dm 打架的来源。okhttp 的 managed 条目一并删：地板有直接条目 okhttp=4.12.0，与本仓
                原面值同值。
            -->

            <!--
                z-bot 用 kernel 全套 (11 核心包), 因为本地 agent 是"完整 z 体系成员",
                直接持有 kernel SPI + 默认实现, 不走 z-agent 平台中转.
                这 12 条是按坐标写的**直接**条目：模块侧这 12 支依赖不写 <version>，删掉条目就静默
                降回 fleet 的 0.1.1；只留属性名（键在、条目不在）同样顶不住。
            -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-llm</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-message</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-types</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-tool</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-memory</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-event</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-middleware</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-workspace</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-agent</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-formatter</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-mcp</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-agent-kernel-credential</artifactId>
                <version>${z-agent-kernel.version}</version>
            </dependency>

            <!--
                TUI 行编辑 (历史/Tab 补全/高亮); 3.24.1 class 版本 52 = Java 8 字节码.
            -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>

            <!--
                Jackson 整族留在 2.13.5（地板面值 2.18.6，preflight 现读）：本仓树里的 jackson 只有
                databind/core/annotations 三件，实测只写 databind 一条时另两件仍落 2.13.5（它们是
                databind 的传递件），三条都写是按坐标钉死、不靠传递就近（照 z-cache 的 log4j 写法）。
            -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <!--
                state.db 持久化; 3.41.x 是最后稳定支持 Java 8 的线, 再往上开始要求 Java 11+.
            -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>3.41.2.2</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- maven-compiler-plugin 的声明删掉了：父链 pluginManagement 下发 3.11.0 +
                 source/target ${maven.compiler.source}/8、${maven.compiler.target}/8 + UTF-8 编码 +
                 -parameters（与本仓手抄那两条同值；class-file major 52 已复验）。
                 maven-release-plugin 与下面 central profile 的发布插件族父链不供，照旧。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.2</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- 改 oss：z-boot-parent 那条 flatten 声明是 <inherited>false</inherited>，不下发，
                         本仓必须自己 flatten，否则发布件带着 org parent。判形状按本仓中央上那一版：
                         z-bot-0.1.0.pom 的 <parent> 计数是 0（自包含），而 resolveCiFriendliesOnly 在
                         换 parent 之后会把 z-boot-parent:1.0.19 原样发出去，也不会解析本仓 DM 里新增的
                         ${project.version}（消费方按它自己的版本去解析，z-boot 那侧实测 404）。oss 两者
                         都落字面量，叶子件（中央上 z-bot-core-0.1.0.pom 带
                         <parent>z-bot:0.1.0</parent>）一并变自包含。
                         常开、不挂 central profile：不带 -P central 的 install 也得入库自包含 pom。 -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <doclint>none</doclint>
                                    <failOnError>false</failOnError>
                                    <failOnWarnings>false</failOnWarnings>
                                    <quiet>true</quiet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- 缺这一行时 deploy 只会把 deployment 推到 validated 态(插件默认 autoPublish=false),
                                 构件对外不可见, 而 Maven 一路报 BUILD SUCCESS。实测 deployment 9ea83397（0.2.0）就是
                                 这样停在 VALIDATED、错误 0 却永远不公开。与其余 25 仓一致。 -->
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>